{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "athlenet_fullstack_updated/athlenet_fullstack/backend",
      "framework": "django",
      "buildCommand": "python manage.py collectstatic --noinput"
    },
    "frontend": {
      "root": "athlenet_fullstack_updated/athlenet_fullstack/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/media/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
